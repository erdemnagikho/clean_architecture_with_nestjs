# Database Configuration
POSTGRES_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clean_shop
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=clean_shop

# Database Selection: 'postgres' or 'mongodb' (for Product catalog polyglot persistence)
DATABASE=postgres

# Mail / SMTP Configuration (e.g. Mailtrap or custom SMTP)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@cleanshop.dev

# Admin User ID for notifications
ADMIN_USER_ID=fbcf91f3-f6a4-4a40-9819-1f581fc4b470

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SUCCESS_URL=http://localhost:3000
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
